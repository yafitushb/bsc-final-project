      "pepper_value": "PEPPER_SECRET_EXAMPLE"
    }
  },

  "users": {
    "file": "users.json",
    "strength_category": "mixed"
  },

  "logging": {
    "output_file": "attempts_full_protection.log",
    "include_latency": true,
    "include_protection_flags": true
